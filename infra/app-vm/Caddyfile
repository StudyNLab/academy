# AIONIT 테스트 운영 Caddy 설정
# 도메인이 정해지기 전: 내부 인증서(tls internal)로 https://localhost 를 연다.
# 도메인이 정해지면 사이트 주소를 도메인으로 바꾸고 tls internal 을 지운다 (Let's Encrypt 자동).
{
	admin off
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
		-Via
	}
	# API 응답(JSON · 파일)은 페이지로 그려질 일이 없다: 무엇도 불러오거나 틀에 넣지 못하게 (M10 보안 점검).
	# 화면의 CSP(nonce)는 web 의 proxy.ts 가 건다
	@api path /api/*
	header @api Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; sandbox"
}

https://localhost {
	tls internal
	import security_headers
	encode zstd gzip
	# 요청 크기 상한 (M10 보안 점검): 앱은 Content-Length 로 먼저 거르지만, 길이를 밝히지 않은(chunked) 요청도 여기서 끊는다.
	# 업로드(교재 패키지 200MB · 첨부 100MB · 영상 조각 16MB)는 운영자 · 강사 API 에만 있다. 나머지는 2MB
	@staff_api path /api/v1/admin/* /api/v1/instructor/*
	request_body @staff_api {
		max_size 202MB
	}
	@other_requests not path /api/v1/admin/* /api/v1/instructor/*
	request_body @other_requests {
		max_size 2MB
	}
	# 관리자 화면 접속 IP 제한 (docs/기술설계.md 3.2). 외부 공개 때 사무실 · VPN 대역으로 바꾸고 주석을 푼다.
	# (respond 를 handle 밖에 두면 Caddy 기본 순서상 아래 handle 이 먼저 응답해 막히지 않는다. 운영 서버용 infra/cloud/Caddyfile 은 켜져 있다)
	# 보안 헤더 · 요청 크기 상한 · /media 권한 확인은 infra/cloud/Caddyfile 과 같게 둔다 (한쪽을 고치면 다른 쪽도)
	# @admin_outside {
	# 	path /admin /admin/* /api/v1/admin /api/v1/admin/*
	# 	not remote_ip 10.100.0.0/16
	# }
	# handle @admin_outside {
	# 	respond 403
	# }

	# 자체 서버 영상 (docs/기술설계.md 5.2 재생 3단계): 재생 목록 · 조각 · 자막 요청마다 web 에 토큰을 물어본 뒤(forward_auth)
	# data VM Garage 의 웹 주소(영상 버킷 aionit-media, 내부망에만 열림)에서 바로 내준다. 조각은 암호화돼 있고 키는 web 이 준다.
	# route: 적은 차례대로 (Caddy 기본 순서로는 uri 가 forward_auth 보다 먼저 돌아 확인할 주소가 바뀐다)
	handle /media/* {
		route {
			forward_auth web:3000 {
				uri /api/v1/media/check
			}
			header Cache-Control "private, no-store"
			uri strip_prefix /media
			reverse_proxy 172.30.0.20:3902 {
				header_up Host aionit-media.web.garage
				header_down -Server
			}
		}
	}

	handle {
		reverse_proxy web:3000
	}
}

http://localhost {
	header -Server
	redir https://{host}{uri} permanent
}

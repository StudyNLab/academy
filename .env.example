# 개발용 설정 예시. 이 파일을 .env 로 복사하고 값을 채운다 (.env 는 Git 에 올리지 않는다).
# 값은 개발 VM(Academy-dev)의 ~/aionit-dev/.env · garage-key.txt 에 있다 (infra/dev-vm/README.md).
DATABASE_URL=postgres://aionit:<비밀번호>@127.0.0.1:15432/aionit
S3_ENDPOINT=http://127.0.0.1:13900
S3_REGION=garage
S3_BUCKET=aionit-dev
S3_ACCESS_KEY_ID=<키 ID>
S3_SECRET_ACCESS_KEY=<비밀 키>
SMTP_URL=smtp://127.0.0.1:11025
# 통합 테스트용 DB (이름이 _test 로 끝나야 한다. 개발 VM PostgreSQL 에 aionit_test 를 만들어 둠)
TEST_DATABASE_URL=postgres://aionit:<비밀번호>@127.0.0.1:15432/aionit_test
# 인증: 세션 서명 · 2단계 인증 비밀값 암호화 · 로그인 기록 해시. 32자 이상 무작위 (openssl rand -base64 48)
BETTER_AUTH_SECRET=<무작위 48바이트>
# 브라우저로 여는 주소 (메일 링크 · Origin 확인 기준)
BETTER_AUTH_URL=http://localhost:3000
MAIL_FROM=AIONIT <no-reply@aionit.local>
# 구글 · 카카오 로그인 (앱 등록 후. 비워 두면 버튼이 보이지 않는다)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

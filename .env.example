# 개발용 설정 예시. 이 파일을 .env 로 복사하고 값을 채운다 (.env 는 Git 에 올리지 않는다).
# 값은 개발 VM(Academy-dev)의 ~/aionit-dev/.env · garage-key.txt 에 있다 (infra/dev-vm/README.md).
DATABASE_URL=postgres://aionit:<비밀번호>@127.0.0.1:15432/aionit
S3_ENDPOINT=http://127.0.0.1:23900
S3_REGION=garage
S3_BUCKET=aionit-dev
# 영상 변환 결과(HLS · 자막) 전용 버킷. 테스트 서버는 Caddy 가 토큰 확인 후 이 버킷의 Garage 웹 주소에서 바로 내준다
S3_MEDIA_BUCKET=aionit-dev-media
S3_ACCESS_KEY_ID=<키 ID>
S3_SECRET_ACCESS_KEY=<비밀 키>
SMTP_URL=smtp://127.0.0.1:11025
# 통합 테스트용 DB (이름이 _test 로 끝나야 한다). 작업 창(worktree)에서는 이름을 aionit_<창 이름>_test 로 바꿔 쓰고,
# 없으면 테스트가 만든다 (infra/dev-vm/README.md '시험 DB'). 이름을 정하려면 TEST_DB_NAME
TEST_DATABASE_URL=postgres://aionit:<비밀번호>@127.0.0.1:15432/aionit_test
# 인증: 세션 서명 · 2단계 인증 비밀값 암호화 · 로그인 기록 해시. 32자 이상 무작위 (openssl rand -base64 48)
BETTER_AUTH_SECRET=<무작위 48바이트>
# 브라우저로 여는 주소 (메일 링크 · Origin 확인 기준)
BETTER_AUTH_URL=http://localhost:3000
MAIL_FROM=AIONIT <no-reply@aionit.local>
# 구글 · 카카오 로그인 (앱 등록 후. 비워 두면 버튼이 보이지 않는다)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 영상 변환 (worker). PATH 에 있으면 비워 둔다
FFMPEG_PATH=
FFPROBE_PATH=
# 토스페이먼츠 (테스트 모드만). 결제위젯 연동 키를 쓴다: 토스 개발자 문서에 공개된 문서용 테스트 키(test_gck_docs_… / test_gsk_docs_…).
# (문서의 API 개별 연동 테스트 키 test_ck_… 는 2026-11 확인 때 토스가 거부했다)
# 비워 두면 구매 버튼이 "결제 준비 중"으로 보인다. 실오픈 때 운영자 상점 키로 바꾼다
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 토스 자동결제(구독, M6): API 개별 연동 키 (test_ck_… / test_sk_…). 운영자가 토스 개발자센터에 가입해 받는 본인 테스트 키.
# 공개 문서용 키로는 자동결제가 안 된다 (NOT_FOUND_MERCHANT). 비워 두면 구독 신청이 "곧 열립니다" 로 보인다
TOSS_BILLING_CLIENT_KEY=
TOSS_BILLING_SECRET_KEY=
# 감시(Gatus)에 worker 가 살아 있다고 알리는 주소 · 토큰 (서버 전용, infra/README.md 감시). 개발 서버는 비워 둔다
MONITOR_WORKER_PUSH_URL=
MONITOR_WORKER_PUSH_TOKEN=
# 바닥글 사업자 정보 (P-10). 비워 두면 "[운영자 입력]" 으로 보인다
BUSINESS_NAME=
BUSINESS_OWNER=
BUSINESS_REG_NO=
BUSINESS_MAIL_ORDER_NO=
BUSINESS_ADDRESS=
BUSINESS_CONTACT=

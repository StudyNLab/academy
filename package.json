{
  "name": "aionit",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @aionit/db generate",
    "db:migrate": "pnpm --filter @aionit/db migrate",
    "dev:tunnel": "node infra/dev-vm/tunnel.mjs"
  },
  "devDependencies": {
    "@aionit/config": "workspace:*",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
